<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.sibarum</groupId>
    <artifactId>vex-suite-common</artifactId>
    <version>0.1.1-SNAPSHOT</version>

    <name>vex-suite-common</name>
    <description>
        What Vexplore and Pix share: the picture sizes they decode at, the viewer's tree and its parts, and the palette
        they are drawn in. Pictures themselves (decoding, packing, textures, the image view) are vexelray-codec's.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-gui.version>0.1.1-SNAPSHOT</vexelray-gui.version>
        <tactroller.version>1.1-SNAPSHOT</tactroller.version>
        <atchung.version>1.1-SNAPSHOT</atchung.version>
        <vexelray-codec.version>0.1.1-SNAPSHOT</vexelray-codec.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- The widget shelf (TitleBar), and the GUI core and draw modules behind it. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The icon atlas: every control's icon, as a distance field. Reached through -widget as well. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-icons</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The clock: the viewer's slides, the filmstrip's glide and the bar's fade. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Keys and input events, which the viewer's shortcuts and its idle fade read. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-api</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- The log. -->
        <dependency>
            <groupId>sibarum.atchung</groupId>
            <artifactId>atchung-probe</artifactId>
            <version>${atchung.version}</version>
        </dependency>
        <!-- Pictures: decoded through imagelib, packed for the GPU, uploaded once and shown on a node (Picture,
             Pictures, Textures, ImageView). What the viewer and the filmstrip are built on. -->
        <dependency>
            <groupId>dev.vexelray.codec</groupId>
            <artifactId>vexelray-codec-image</artifactId>
            <version>${vexelray-codec.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Anything that reaches the codec's decoder crosses into imagelib's native library. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
