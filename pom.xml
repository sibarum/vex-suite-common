<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.sibarum</groupId>
    <artifactId>vex-suite-common</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>vex-suite-common</name>
    <description>
        What Vexplore and Pix share: pictures decoded and packed for the GPU, the viewer's tree and its parts, and the
        palette they are drawn in.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
        <tactroller.version>1.0-SNAPSHOT</tactroller.version>
        <atchung.version>1.0-SNAPSHOT</atchung.version>
        <imagelib.version>0.1.0-SNAPSHOT</imagelib.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- The widget shelf (TitleBar), and the GUI core and draw modules behind it. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- The clock: the viewer's slides, the filmstrip's glide and the bar's fade. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Keys and input events, which the viewer's shortcuts and its idle fade read. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-api</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- The log. -->
        <dependency>
            <groupId>sibarum.atchung</groupId>
            <artifactId>atchung-probe</artifactId>
            <version>${atchung.version}</version>
        </dependency>
        <!-- Pixels from any image file as RGBA8 ready to upload. The GUI decodes nothing itself, by design. -->
        <dependency>
            <groupId>sibarum.imagelib</groupId>
            <artifactId>imagelib-wrapper</artifactId>
            <version>${imagelib.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- The picture tests decode for real, through imagelib's native library. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
