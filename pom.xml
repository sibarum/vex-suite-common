<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.sibarum</groupId>
    <artifactId>vex-suite-common-parent</artifactId>
    <version>0.1.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>vex-suite-common-parent</name>
    <description>
        What the suite's applications share, as modules: vex-suite-common itself (the viewer, the terminal widgets,
        git, updates), and the pseudo-terminal under the terminal: vex-suite-common-pty, the platform-neutral Pty,
        with one vex-suite-common-pty-&lt;os&gt; module per operating system.
    </description>

    <modules>
        <!-- The platform-neutral pseudo-terminal: Pty, and the PtyPlatform each OS module provides. -->
        <module>vex-suite-common-pty</module>
        <!-- Its OS halves. vex-suite-common's OS-activated profiles add one. -->
        <module>vex-suite-common-pty-windows</module>
        <module>vex-suite-common-pty-linux</module>
        <!-- What updating needs from an OS, and its Windows half (the installer only installs on Windows). -->
        <module>vex-suite-common-update</module>
        <module>vex-suite-common-update-windows</module>
        <!-- The library the applications depend on, under the artifactId they already name. -->
        <module>vex-suite-common</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray.version>0.1.2-SNAPSHOT</vexelray.version>
        <vexelray-gui.version>0.1.2-SNAPSHOT</vexelray-gui.version>
        <tactroller.version>1.2-SNAPSHOT</tactroller.version>
        <atchung.version>1.2-SNAPSHOT</atchung.version>
        <vexelray-codec.version>0.1.2-SNAPSHOT</vexelray-codec.version>
        <supirvast.version>0.2.2-SNAPSHOT</supirvast.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.sibarum</groupId>
                <artifactId>vex-suite-common-pty</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.sibarum</groupId>
                <artifactId>vex-suite-common-pty-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.sibarum</groupId>
                <artifactId>vex-suite-common-pty-linux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.sibarum</groupId>
                <artifactId>vex-suite-common-update</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.sibarum</groupId>
                <artifactId>vex-suite-common-update-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Platform-specific code only in -windows, -linux and -macos modules: vexelray-build's isolate goal fails
                 the build on any outside them (vexelray-build/README.md). -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.2-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>isolate</id>
                        <goals>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- Every module here crosses into native code: imagelib through the codec, the OS's own
                             pseudo-terminal calls through the pty modules. -->
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
